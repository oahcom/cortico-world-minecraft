  "files": [
    "src",
    "dist",
    "describe.json",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "mineflayer": "4.37.1",
    "mineflayer-pathfinder": "2.4.5",
    "prismarine-viewer": "1.33.0",
    "vec3": "0.2.0"
  }
