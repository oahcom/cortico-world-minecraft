{
  "name": "cortico-world-minecraft",
  "version": "0.2.13",
  "type": "module",
  "description": "Cortico World: Minecraft Java Edition through a Mineflayer player — observation text, movement, building, combat and an observer client",
  "author": "Pal AI Lab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pal-AI-Lab/Cortico.git",
    "directory": "src/worlds/minecraft"
  },
  "homepage": "https://github.com/Pal-AI-Lab/Cortico/tree/main/src/worlds/minecraft#readme",
  "bugs": {
    "url": "https://github.com/Pal-AI-Lab/Cortico/issues"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "minecraft",
    "mineflayer"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.ts",
